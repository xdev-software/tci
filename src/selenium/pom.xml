<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>software.xdev.tci</groupId>
		<artifactId>src</artifactId>
		<version>4.5.2-SNAPSHOT</version>
	</parent>

	<artifactId>selenium</artifactId>
	<packaging>jar</packaging>

	<name>selenium</name>
	<description>TCI - selenium</description>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.seleniumhq.selenium</groupId>
				<artifactId>selenium-dependencies-bom</artifactId>
				<version>4.49.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>software.xdev.tci</groupId>
			<artifactId>base</artifactId>
			<version>4.5.2-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>software.xdev.tci</groupId>
			<artifactId>jul-to-slf4j</artifactId>
			<version>4.5.2-SNAPSHOT</version>
		</dependency>
		<!-- Can be removed once SeleniumRecordingExtension is gone -->
		<dependency>
			<groupId>software.xdev.tci</groupId>
			<artifactId>junit-jupiter-api-support</artifactId>
			<version>4.5.2-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>software.xdev</groupId>
			<artifactId>testcontainers-selenium</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- Selenium -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-remote-driver</artifactId>
			<!-- Tracing is not needed -->
			<exclusions>
				<exclusion>
					<groupId>io.opentelemetry</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-support</artifactId>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-firefox-driver</artifactId>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-chrome-driver</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>ignore-service-loading</id>
			<build>
				<resources>
					<resource>
						<directory>src/main/resources</directory>
						<excludes>
							<exclude>META-INF/services/**</exclude>
						</excludes>
					</resource>
				</resources>
			</build>
		</profile>
	</profiles>
</project>
